{
  "Security": {
    "DataProtectionKeysPath": ".data-protection-keys"
  },
  "OpenApi": {
    "Enabled": true
  },
  "DevelopmentSeed": {
    "Enabled": true,
    "ResetOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
