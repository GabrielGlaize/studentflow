{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5433;Database=studyflow;Username=studyflow;Password=studyflow"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "School": {
    "TimeZone": "Europe/Paris"
  },
