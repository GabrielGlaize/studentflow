{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5433;Database=studyflow;Username=studyflow;Password=studyflow"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8080"
    ]
  },
  "Jwt": {
    "Issuer": "StudyFlow.Api",
    "Audience": "StudyFlow.App",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30
  },
  "LaBonneAlternance": {
    "BaseUrl": "",
    "SearchPath": "/fr/explorer/recherche-offre",
    "AccessToken": "",
    "UseDemoWhenNotConfigured": true
  },
  "Adzuna": {
    "BaseUrl": "https://api.adzuna.com",
    "Country": "fr",
    "AppId": "",
    "AppKey": "",
    "ResultsPerPage": 10,
    "UseDemoWhenNotConfigured": true
  },
  "FranceTravail": {
    "TokenUrl": "https://entreprise.francetravail.fr/connexion/oauth2/access_token",
    "Realm": "/partenaire",
    "SearchUrl": "https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search",
    "ClientId": "",
    "ClientSecret": "",
    "Scope": "api_offresdemploiv2 o2dsoffre",
    "ResultsPerPage": 10,
    "UseDemoWhenNotConfigured": false
  },
  "Security": {
    "DataProtectionKeysPath": ".data-protection-keys",
    "PasswordResetTokenMinutes": 30
  },
  "NotificationWorker": {
    "Enabled": false,
    "IntervalSeconds": 60,
    "LookBehindMinutes": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
