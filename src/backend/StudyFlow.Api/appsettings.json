    "ClientId": "",
    "ClientSecret": "",
    "Scope": "api_offresdemploiv2 o2dsoffre",
    "ResultsPerPage": 20
  },
  "Security": {
    "DataProtectionKeysPath": ".data-protection-keys",
    "PasswordResetTokenMinutes": 30,
