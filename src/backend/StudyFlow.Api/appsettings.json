      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "http://localhost:4174",
      "http://127.0.0.1:4174",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "Jwt": {
    "Issuer": "StudyFlow.Api",
    "Audience": "StudyFlow.App",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30
  },
  "LaBonneAlternance": {
    "BaseUrl": "https://api.apprentissage.beta.gouv.fr/api",
    "AccessToken": "",
    "MaxResults": 30
  },
  "Geocoding": {
    "BaseUrl": "https://data.geopf.fr/geocodage"
  },
  "Adzuna": {
    "BaseUrl": "https://api.adzuna.com",
    "Country": "fr",
    "AppId": "",
    "AppKey": "",
