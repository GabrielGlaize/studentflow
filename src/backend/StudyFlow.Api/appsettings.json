    "Refresh": { "PermitLimit": 60, "WindowSeconds": 60 },
    "ClassJoin": { "PermitLimit": 10, "WindowSeconds": 900 },
    "PublicSearch": { "PermitLimit": 30, "WindowSeconds": 60 }
