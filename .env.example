STUDYFLOW_POSTGRES=Host=localhost;Port=5433;Database=studyflow;Username=studyflow;Password=change-me
Jwt__SigningKey=replace-with-at-least-32-random-characters
Security__LookupKey=replace-with-an-independent-32-character-secret
Security__DataProtectionKeysPath=/secure/path/outside-the-database

# La Bonne Alternance API - backend only, never inside Flutter.
LaBonneAlternance__BaseUrl=https://api.apprentissage.beta.gouv.fr
LaBonneAlternance__SearchPath=/fr/explorer/recherche-offre
LaBonneAlternance__AccessToken=replace-with-server-token

# Notification worker is disabled by default until a real push provider is configured.
NotificationWorker__Enabled=false
NotificationWorker__IntervalSeconds=60
NotificationWorker__LookBehindMinutes=2
