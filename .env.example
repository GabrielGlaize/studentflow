STUDYFLOW_POSTGRES=Host=localhost;Port=5433;Database=studyflow;Username=studyflow;Password=change-me
Jwt__SigningKey=replace-with-at-least-32-random-characters
Security__LookupKey=replace-with-an-independent-32-character-secret
Security__DataProtectionKeysPath=.data-protection-keys
Security__PasswordResetTokenMinutes=30

# La Bonne Alternance API - backend only, never inside Flutter.
LaBonneAlternance__BaseUrl=https://api.apprentissage.beta.gouv.fr
LaBonneAlternance__SearchPath=/fr/explorer/recherche-offre
LaBonneAlternance__AccessToken=replace-with-server-token

# Adzuna API - backend only, never inside Flutter.
Adzuna__BaseUrl=https://api.adzuna.com
Adzuna__Country=fr
Adzuna__AppId=replace-with-adzuna-app-id
Adzuna__AppKey=replace-with-adzuna-app-key
Adzuna__ResultsPerPage=10

# France Travail API Offres d'emploi - backend only.
# Free developer access, but it requires a client id and client secret from France Travail.
FranceTravail__TokenUrl=https://entreprise.francetravail.fr/connexion/oauth2/access_token
FranceTravail__Realm=/partenaire
FranceTravail__SearchUrl=https://api.francetravail.io/partenaire/offresdemploi/v2/offres/search
FranceTravail__ClientId=replace-with-france-travail-client-id
FranceTravail__ClientSecret=replace-with-france-travail-client-secret
FranceTravail__Scope=api_offresdemploiv2 o2dsoffre
FranceTravail__ResultsPerPage=10

# Notification worker is disabled by default until a real push provider is configured.
NotificationWorker__Enabled=false
NotificationWorker__IntervalSeconds=60
NotificationWorker__LookBehindMinutes=2
