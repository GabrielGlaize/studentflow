# .NET
.dotnet-home/
.dotnet-sdk/
**/bin/
**/obj/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-plugins-dependencies *
.packages
build/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.nas.example
.data-protection-keys/

# Accidental macOS duplicate copies of generated Flutter/iOS files.
src/app/ios/Podfile *.lock
src/app/ios/Flutter/* 2.*
src/app/ios/Flutter/* 3.*

# Firebase : identifiants du projet et compte de service, jamais dans le dépôt public.
src/app/firebase_config.json
**/google-services.json
**/GoogleService-Info.plist
**/*firebase-adminsdk*.json
/secrets/
