STUDYFLOW_POSTGRES_DB=studyflow
STUDYFLOW_POSTGRES_USER=studyflow
STUDYFLOW_POSTGRES_PASSWORD=replace-with-a-long-random-password

STUDYFLOW_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters-for-jwt
STUDYFLOW_SECURITY_LOOKUP_KEY=replace-with-at-least-32-random-characters-for-hmac

# Port exposed by the NAS on the local network.
STUDYFLOW_API_PORT=5028

# Use the final HTTPS origin if you expose the API through a reverse proxy.
# For native Flutter iPhone calls this is not critical, but it is useful for web builds.
STUDYFLOW_CORS_ORIGIN=https://studyflow.example.com

# Optional alternance providers. With none configured, the API returns demo offers.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# La bonne alternance (offres LBA + France Travail + partenaires) : clé gratuite sur
# https://api.apprentissage.beta.gouv.fr/compte/profil
LBA_API_KEY=

# Notifications push Firebase. Copier la clé du compte de service dans ./secrets/
# (jamais dans Git) puis indiquer son chemin vu depuis le conteneur.
# Laisser vide pour désactiver l'envoi réel.
STUDYFLOW_FIREBASE_CREDENTIALS_PATH=/run/secrets/studyflow/firebase-adminsdk.json
STUDYFLOW_NOTIFICATIONS_ENABLED=true

# E-mails de réinitialisation de mot de passe (SMTP). Sans ces valeurs, aucun
# e-mail ne part. Exemple Gmail : créer un « mot de passe d'application »
# (compte Google > Sécurité > Validation en deux étapes > Mots de passe des
# applications) ; le mot de passe habituel du compte ne fonctionne pas.
STUDYFLOW_EMAIL_FROM=StudyFlow <ton.adresse@gmail.com>
STUDYFLOW_EMAIL_HOST=smtp.gmail.com
STUDYFLOW_EMAIL_PORT=587
STUDYFLOW_EMAIL_USE_SSL=true
STUDYFLOW_EMAIL_USERNAME=ton.adresse@gmail.com
STUDYFLOW_EMAIL_PASSWORD=mot-de-passe-d-application-16-caracteres
